// =============================================================================
// OpenList-TSWorker · Cloudflare Workers 配置
// 文档：https://developers.cloudflare.com/workers/wrangler/configuration/
//
// Secret（JWT_SECRET / ADMIN_PASS / ALLOW_URLS / MYSQL_URLS / EO_KV_URLS / CF_* 等）请在
// .dev.vars.example 或 .env.example 中声明 —— 部署按钮据此生成输入项，
// 用户填入的值会成为该 Worker 的 Secret，后续更新不会被覆盖。
// =============================================================================
{
  "name": "openlist-tsworkers",
  "main": "src/backend/worker.ts",

  // iconv-lite 只有 FTP 驱动在用，而 Workers 没有 TCP socket、FTP 驱动不可用。
  // build-edge.mjs 早已把 iconv-lite 当作 external / 空模块，但 `wrangler deploy`
  // 不经过那条链路，仍会去解析它以及它的传递依赖 safer-buffer（issue #151）。
  // 这里指向空桩，让 Wrangler 的打包与其它产物的行为一致。
  "alias": {
    "iconv-lite": "./src/backend/drivers/ftp/iconv-stub.ts"
  },
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html"]
  },

  // ===========================================================================
  // 普通环境变量（非敏感）
  // 注意：vars 会在每次 wrangler deploy 时被本文件覆盖（Secrets 不会）。
  // ===========================================================================
  "vars": {
    "ENVIRONMENT": "production",
    "DB_FORMAT": "sql",
    "DB_DRIVER": "d1",
    "DB_CIPHER": "none"
  },

  // ===========================================================================
  // 存储绑定
  // ===========================================================================
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "openlist-db",
      "database_id": "0685c18d-b96c-479a-b3c5-def4ef369d68"
    }
  ]
}
